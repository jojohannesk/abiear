<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nur Dunkelmodus, wie unter iOS. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/grund</item>
        <item name="colorPrimaryDark">@color/grund</item>
        <item name="colorAccent">#00D1DA</item>
        <item name="android:windowBackground">@color/grund</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/grund</item>
    </style>

    <!-- Startbild: das Symbol auf dem Grund der App, kein eigenes Bild. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/grund</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/grund</item>
    </style>
</resources>
